# Build apps/admin and its workspace dependencies before assembling this image.
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
ENV NODE_ENV=production HOSTNAME=127.0.0.1 PORT=13004
WORKDIR /app
RUN groupadd --gid 1001 agency && useradd --uid 1001 --gid 1001 --no-create-home agency
COPY --chown=1001:1001 . /app
USER 1001:1001
CMD ["node", "apps/admin/server.js"]
